---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import GoogleMap from "../../components/GoogleMap.astro";
import { ATTRACTION, OFFICIAL_SOURCES } from "../../data/attraction";
import { SITE } from "../../data/site";

const PAGE_URL = `${SITE.url}/en/transportation/`;

/** 三個最常被搞混的下車／導航點 */
const places = [
  {
    name: "Longteng Bridge",
    local: "龍騰斷橋",
    what: "The monument itself, signposted on Miaoli County Road 49",
    use: "The red-brick arches, the main viewing area and the steel bridge beyond it",
  },
  {
    name: "Longteng Station",
    local: "龍騰站",
    what: "The rail bike boarding station further up the valley",
    use: "Starting routes B and C on the Old Mountain Line rail bike",
  },
  {
    name: "Shengxing Station",
    local: "勝興車站",
    what: "The old mountain line station at roughly 402 m, with an old street",
    use: "Route A departures, food, the station building and the old street",
  },
];

const driveSteps = [
  {
    title: "National Freeway 1 to the Sanyi Interchange",
    text: "Leave the freeway at the Sanyi Interchange (三義交流道) and follow the brown tourist signs rather than your intuition — the monument is not in the town centre.",
  },
  {
    title: "Onto Miaoli County Road 49",
    text: "County Road 49 climbs out of Sanyi into the hills. It is the only practical route up to the bridge and it carries farm traffic as well as visitors.",
  },
  {
    title: "Expect a narrow, winding mountain road",
    text: "The last stretch is single-carriageway with limited passing space and occasional coaches. Drive it in daylight if you can, and expect slower traffic in both directions.",
  },
  {
    title: "Aim for the right car park",
    text: "The monument and the rail bike station have separate parking areas. Decide which one you are visiting first, then follow the signs for that one instead of parking at whichever appears first.",
  },
];

const faqs = [
  {
    q: "Do I need a car to visit Longteng Bridge?",
    a: "No, but it is the easiest option. By public transport you take the Taiwan Railways Administration to Sanyi Station and then continue uphill by taxi, pre-arranged transfer or local bus. The uphill leg is the part that needs planning.",
  },
  {
    q: "Which station should I get off at?",
    a: "Sanyi Station on the main line is where trains stop. There is no conventional train service to the monument. Longteng Station and Shengxing Station are rail bike boarding stations on the old mountain line, and they are different places from Sanyi Station.",
  },
  {
    q: "Is there parking at the bridge?",
    a: "Yes, but there are separate areas for the monument and for the rail bike station, and they are not interchangeable. Parking capacity is limited at weekends and on holidays, so arriving before mid-morning makes a noticeable difference. Fees and opening hours of private car parks change and are not published here.",
  },
  {
    q: "Can I visit as a day trip from Taipei?",
    a: "Yes, as a long day. Sanyi is served by Taiwan Railways services and, for most departures from Taipei, the journey involves a change or a slower mountain-line service. Check the current timetable, and remember the return leg as well — the last taxi up the hill is the easy part, getting back down is not.",
  },
  {
    q: "What happens in rain or fog?",
    a: "The monument does not close for rain, but the roads into the valley lose visibility quickly and the brick steps become slippery. Severe weather can suspend the rail bike. If you are driving, treat the mountain road as the main risk rather than the site itself.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${PAGE_URL}#faq`,
  inLanguage: "en",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${PAGE_URL}#webpage`,
  url: PAGE_URL,
  name: "Getting to the Remains of Longteng Bridge",
  inLanguage: "en",
  about: { "@id": `${SITE.url}/#attraction` },
  isPartOf: { "@id": `${SITE.url}/#website` },
  significantLink: [`${SITE.url}/en/`, `${SITE.url}/transportation/`, `${SITE.url}/weather/`],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "English guide", item: `${SITE.url}/en/` },
    { "@type": "ListItem", position: 2, name: "Getting there", item: PAGE_URL },
  ],
};
---

<BaseLayout
  lang="en"
  title="Getting to Longteng Bridge｜Car, Train and the Three Different Stations"
  description="How to reach the Remains of Longteng Bridge in Sanyi, Miaoli: Freeway 1 and the Sanyi Interchange, County Road 49, train to Sanyi Station, plus which of the three stations you actually want."
  imageAlt="View over the Remains of Longteng Bridge and the Yutengping Iron Bridge in Sanyi, Miaoli"
  schema={[pageSchema, faqSchema, breadcrumbSchema]}
>
  <header class="section-shell pt-10 sm:pt-16">
    <nav class="mb-7 flex items-center gap-2 text-xs font-bold text-stone" aria-label="Breadcrumb">
      <a href="/en/" class="hover:text-brick-700">English guide</a>
      <Icon name="chevron" size={13} />
      <span aria-current="page">Getting there</span>
    </nav>

    <span class="eyebrow">Directions</span>
    <h1
      class="editorial-title mt-5 max-w-4xl text-[clamp(2.3rem,5.6vw,4.4rem)] font-bold leading-[1.02] text-ink"
    >
      How to get to the
      <br />
      Remains of Longteng Bridge
    </h1>
    <p class="mt-6 max-w-3xl text-base leading-8 text-stone sm:text-lg">
      The difficult part of this trip is not the driving distance — it is that three different places
      in the same valley all sound like "the bridge". Longteng Bridge the monument, Longteng Station
      the rail bike stop and Shengxing Station are separate destinations on the same narrow mountain
      road. Choosing wrong costs you half an hour of winding road.
    </p>

    <div class="mt-6 flex flex-wrap gap-3 text-xs font-bold">
      <a
        href={ATTRACTION.mapsShareUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full bg-forest-700 px-3.5 py-2 text-white"
      >
        <Icon name="map" size={15} />
        Open the monument in Google Maps
      </a>
      <a
        href="#stations"
        class="inline-flex items-center gap-2 rounded-full bg-brick-100 px-3.5 py-2 text-brick-700"
      >
        <Icon name="compass" size={15} />
        Which station do I want?
      </a>
    </div>

    <div class="mt-10 grid gap-3 sm:grid-cols-3">
      {
        [
          {
            icon: "car" as const,
            label: "By car",
            value: "Freeway 1, Sanyi Interchange",
            note: "Then County Road 49 into the hills",
          },
          {
            icon: "train" as const,
            label: "By train",
            value: "Sanyi Station",
            note: "Then taxi, transfer or local bus uphill",
          },
          {
            icon: "rail" as const,
            label: "By rail bike",
            value: "Longteng or Shengxing Station",
            note: "Booking required, separate timetable",
          },
        ].map((item) => (
          <div class="rounded-2xl border border-black/8 bg-white/72 p-5">
            <span class="flex size-9 items-center justify-center rounded-full bg-forest-100 text-forest-700">
              <Icon name={item.icon} size={18} />
            </span>
            <p class="mt-4 text-[0.67rem] font-black tracking-[0.14em] text-stone uppercase">
              {item.label}
            </p>
            <p class="mt-1.5 font-extrabold text-ink">{item.value}</p>
            <p class="mt-1 text-sm leading-7 text-stone">{item.note}</p>
          </div>
        ))
      }
    </div>
  </header>

  <section id="stations" class="section-shell mt-16 scroll-mt-24">
    <span class="eyebrow">The one mistake to avoid</span>
    <h2 class="editorial-title mt-4 text-3xl font-bold text-ink sm:text-4xl">
      Three places, three different pins
    </h2>
    <p class="mt-5 max-w-3xl text-sm leading-8 text-stone">
      Searching "Longteng" in a maps app returns more than one result, and in Chinese the three names
      are even easier to confuse. Decide first which of these you are heading to.
    </p>

    <div class="mt-9 overflow-x-auto">
      <table class="w-full min-w-[44rem] border-collapse text-sm">
        <thead>
          <tr class="border-b border-black/10 text-left">
            <th class="px-4 py-3 font-black text-ink">Place</th>
            <th class="px-4 py-3 font-black text-ink">What it is</th>
            <th class="px-4 py-3 font-black text-ink">Why you would go there</th>
          </tr>
        </thead>
        <tbody>
          {
            places.map((place) => (
              <tr class="border-b border-black/8 align-top">
                <td class="px-4 py-4">
                  <strong class="block font-extrabold text-ink">{place.name}</strong>
                  <span class="mt-1 block text-xs leading-6 text-stone">{place.local}</span>
                </td>
                <td class="px-4 py-4 leading-7 text-stone">{place.what}</td>
                <td class="px-4 py-4 leading-7 text-stone">{place.use}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="mt-8 rounded-2xl border border-brick-200 bg-brick-50 p-5">
      <p class="text-sm font-extrabold text-brick-700">If you only remember one thing</p>
      <p class="mt-2 text-sm leading-7 text-brick-700/90">
        The monument is on County Road 49 and free to visit. The rail bike stations are further up the
        valley and require a booking. Entering "Longteng Station" into your navigation when you want
        the bricks-and-arches viewpoint will take you to the wrong car park.
      </p>
    </div>
  </section>

  <section class="section-shell mt-16">
    <span class="eyebrow">Self-driving</span>
    <h2 class="editorial-title mt-4 text-3xl font-bold text-ink sm:text-4xl">By car</h2>
    <p class="mt-5 max-w-3xl text-sm leading-8 text-stone">
      Driving gives you the most control over timing, and it is how most domestic visitors arrive. The
      route is short but the last section demands attention.
    </p>

    <ol class="mt-9 grid gap-3 lg:grid-cols-2">
      {
        driveSteps.map((step, index) => (
          <li class="rounded-2xl border border-black/8 bg-white/72 p-5">
            <span class="flex size-8 items-center justify-center rounded-full bg-brick-100 text-xs font-black text-brick-700">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-4 font-extrabold text-ink">{step.title}</h3>
            <p class="mt-2 text-sm leading-7 text-stone">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section-shell mt-16">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Parking</span>
        <h2 class="editorial-title mt-4 text-3xl font-bold text-ink sm:text-4xl">
          Parking is two separate problems
        </h2>
        <p class="mt-5 text-sm leading-8 text-stone">
          Visitors who park once and expect to walk to everything are usually disappointed. The
          monument and the rail bike station sit at different points on the same road, and each has
          its own limited parking.
        </p>
        <ul class="mt-6 grid gap-3 text-sm leading-7 text-stone">
          <li class="rounded-2xl border border-black/8 bg-white/72 p-5">
            <strong class="block font-extrabold text-ink">Visiting the monument only</strong>
            Park at the monument area, see the arches and the steel bridge, then continue on foot to
            the nearby viewpoints. This is the short stop.
          </li>
          <li class="rounded-2xl border border-black/8 bg-white/72 p-5">
            <strong class="block font-extrabold text-ink">Riding the rail bike</strong>
            Park at the station you are boarding from — Longteng Station or Shengxing Station — and
            arrive with time before your booked departure.
          </li>
          <li class="rounded-2xl border border-black/8 bg-white/72 p-5">
            <strong class="block font-extrabold text-ink">Weekends and holidays</strong>
            Capacity is the constraint, not price. Starting early is more effective than any
            navigation trick, and coaches occupy large spaces in the middle of the day.
          </li>
        </ul>
      </div>

      <div>
        <span class="eyebrow">Public transport</span>
        <h2 class="editorial-title mt-4 text-3xl font-bold text-ink sm:text-4xl">
          By train, then uphill
        </h2>
        <p class="mt-5 text-sm leading-8 text-stone">
          Sanyi is served by Taiwan Railways Administration services on the main line. From Sanyi
          Station, the monument is still several kilometres uphill on a mountain road.
        </p>
        <ul class="mt-6 grid gap-3 text-sm leading-7 text-stone">
          <li class="rounded-2xl border border-black/8 bg-white/72 p-5">
            <strong class="block font-extrabold text-ink">Getting to Sanyi</strong>
            Trains stop at Sanyi Station, and journey times from Taipei make this a long day trip.
            Timetables change with season and service type, so check the operator rather than a
            cached search result.
          </li>
          <li class="rounded-2xl border border-black/8 bg-white/72 p-5">
            <strong class="block font-extrabold text-ink">Sanyi Station to the bridge</strong>
            Continue by taxi or pre-arranged transfer — the fastest and most predictable option — or
            by local bus, which is cheaper but infrequent and stops at fixed points.
          </li>
          <li class="rounded-2xl border border-black/8 bg-white/72 p-5">
            <strong class="block font-extrabold text-ink">Plan the return leg first</strong>
            The uphill trip is easier to arrange than the way back. Ask your driver or check the last
            departure before you start sightseeing, especially late in the day.
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10">
      <GoogleMap
        lang="en"
        title="Remains of Longteng Bridge on Google Maps"
        query="龍騰斷橋 苗栗縣三義鄉"
      />
    </div>
  </section>

  <section class="section-shell mt-16">
    <span class="eyebrow">Combining the trip</span>
    <h2 class="editorial-title mt-4 text-3xl font-bold text-ink sm:text-4xl">
      Two workable half-days
    </h2>

    <div class="mt-9 grid gap-3 lg:grid-cols-2">
      <div class="rounded-2xl border border-black/8 bg-white/72 p-6">
        <span class="flex size-9 items-center justify-center rounded-full bg-forest-100 text-forest-700">
          <Icon name="car" size={18} />
        </span>
        <h3 class="mt-4 font-extrabold text-ink">With a car</h3>
        <p class="mt-2 text-sm leading-8 text-stone">
          Freeway 1 to the Sanyi Interchange, then up County Road 49 to the monument first, before the
          car parks fill. Drive on to Shengxing Station for the old street and food, and finish with
          the rail bike if you have booked it. Driving between the three points is short but slow, so
          allow more than the distance suggests.
        </p>
      </div>
      <div class="rounded-2xl border border-black/8 bg-white/72 p-6">
        <span class="flex size-9 items-center justify-center rounded-full bg-forest-100 text-forest-700">
          <Icon name="train" size={18} />
        </span>
        <h3 class="mt-4 font-extrabold text-ink">Without a car</h3>
        <p class="mt-2 text-sm leading-8 text-stone">
          Train to Sanyi Station, taxi up to the monument, then either walk the connecting paths or
          take another taxi to Shengxing Station. Pick one rail bike route if you want track-level
          views, and agree the return trip early. Trying to cover the monument, the old street and a
          full rail bike route on foot in one afternoon does not work.
        </p>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-3 rounded-2xl border border-black/8 bg-white/72 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm leading-7 text-stone">
        Booking a rail bike route changes which station you drive to, so settle the boarding point
        before you decide where to park.
      </p>
      <div class="flex shrink-0 flex-wrap gap-x-5 gap-y-2">
        <a
          href="/en/rail-bike/"
          class="inline-flex items-center gap-2 text-sm font-black text-brick-700"
        >
          Rail bike routes and boarding points
          <Icon name="arrow" size={16} />
        </a>
        <a
          href="/en/itinerary/"
          class="inline-flex items-center gap-2 text-sm font-black text-brick-700"
        >
          Day-trip plans
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>

  <section id="faq" class="section-shell mt-16 scroll-mt-24">
    <span class="eyebrow">FAQ</span>
    <h2 class="editorial-title mt-4 text-3xl font-bold text-ink sm:text-4xl">
      Common questions
    </h2>

    <div class="mt-9 grid max-w-3xl gap-3">
      {
        faqs.map((item) => (
          <details class="group rounded-2xl border border-black/8 bg-white/72 px-5 py-4">
            <summary class="cursor-pointer list-none font-extrabold text-ink marker:content-none">
              <span class="flex items-start justify-between gap-4">
                {item.q}
                <Icon
                  name="chevron"
                  size={17}
                  class="mt-1 shrink-0 text-brick-600 transition group-open:rotate-90"
                />
              </span>
            </summary>
            <p class="mt-3 text-sm leading-8 text-stone">{item.a}</p>
          </details>
        ))
      }
    </div>

    <div class="mt-10 rounded-[1.75rem] border border-black/8 bg-white/72 p-6 sm:p-8">
      <span class="eyebrow">Official sources</span>
      <p class="mt-5 max-w-3xl text-sm leading-8 text-stone">
        Road conditions, bus services, rail bike timetables and fares change. Confirm them with the
        bodies below before you travel — that is why this page explains how to decide instead of
        printing numbers that go stale.
      </p>
      <ul class="mt-6 grid gap-2.5 sm:grid-cols-2">
        {
          OFFICIAL_SOURCES.map((source) => (
            <li>
              <a
                href={source.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-start gap-3 rounded-xl border border-black/8 bg-white px-4 py-3 text-sm font-bold text-ink transition hover:border-brick-200"
              >
                <Icon name="check" size={16} class="mt-0.5 shrink-0 text-forest-600" />
                <span>{source.nameEn}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/en/"
          class="inline-flex items-center gap-2 rounded-full border border-black/10 bg-white px-4 py-2.5 text-sm font-bold text-ink transition hover:border-brick-300"
        >
          <Icon name="book" size={16} />
          Back to the visitor guide
        </a>
        <a
          href="/en/itinerary/"
          class="inline-flex items-center gap-2 rounded-full bg-forest-700 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-forest-600"
        >
          <Icon name="compass" size={16} />
          Plan the whole day
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
