---
import Icon from "./Icon.astro";
---

<article
  class="weather-card overflow-hidden rounded-[2rem] border border-black/8 bg-white shadow-soft"
  data-weather-card
  aria-labelledby="weather-heading"
>
  <div class="grid lg:grid-cols-[0.88fr_1.12fr]">
    <div class="relative overflow-hidden bg-forest-700 p-6 text-white sm:p-9">
      <div
        class="pointer-events-none absolute -right-20 -top-20 size-64 rounded-full border border-white/10"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute -right-8 top-8 size-40 rounded-full border border-white/10"
        aria-hidden="true"
      ></div>

      <div class="relative">
        <p class="text-xs font-black tracking-[0.17em] text-white/55 uppercase">
          龍騰山區天氣
        </p>
        <h2
          id="weather-heading"
          class="editorial-title mt-4 text-3xl font-bold leading-tight sm:text-4xl"
        >
          天氣先看，<br />行程再排
        </h2>
        <p class="mt-4 max-w-md text-sm leading-7 text-white/66">
          固定查詢魚藤坪斷橋周邊，提供目前天氣、降雨機率與三日預報。
        </p>

        <div
          class="mt-7 flex min-h-52 items-center justify-center rounded-2xl border border-white/10 bg-black/12 p-6"
          data-weather-loading
          role="status"
        >
          <div class="text-center">
            <span class="weather-loader mx-auto block size-9 rounded-full border-2 border-white/25 border-t-white"></span>
            <p class="mt-4 text-sm font-bold text-white/72">正在取得斷橋周邊天氣…</p>
          </div>
        </div>

        <div class="mt-7 hidden" data-weather-current>
          <div class="flex flex-wrap items-end justify-between gap-5">
            <div class="flex items-center gap-4">
              <span
                class="text-5xl leading-none sm:text-6xl"
                data-current-icon
                aria-hidden="true"
              ></span>
              <div>
                <p class="text-base font-black" data-current-condition></p>
                <p class="mt-1 text-xs text-white/58">
                  體感 <span data-current-apparent></span>°C
                </p>
              </div>
            </div>
            <p class="text-6xl font-black tracking-[-0.07em] sm:text-7xl">
              <span data-current-temperature></span><span class="ml-1 text-2xl text-white/55">°C</span>
            </p>
          </div>

          <div class="mt-7 grid grid-cols-2 gap-2">
            <div class="rounded-xl bg-white/9 p-3.5">
              <p class="text-[0.67rem] font-black tracking-[0.12em] text-white/48 uppercase">
                今日高低溫
              </p>
              <p class="mt-1.5 text-sm font-black">
                <span data-today-high></span>° / <span data-today-low></span>°
              </p>
            </div>
            <div class="rounded-xl bg-white/9 p-3.5">
              <p class="text-[0.67rem] font-black tracking-[0.12em] text-white/48 uppercase">
                降雨機率
              </p>
              <p class="mt-1.5 text-sm font-black"><span data-today-rain></span>%</p>
            </div>
            <div class="rounded-xl bg-white/9 p-3.5">
              <p class="text-[0.67rem] font-black tracking-[0.12em] text-white/48 uppercase">
                平均風速
              </p>
              <p class="mt-1.5 text-sm font-black"><span data-current-wind></span> km/h</p>
            </div>
            <div class="rounded-xl bg-white/9 p-3.5">
              <p class="text-[0.67rem] font-black tracking-[0.12em] text-white/48 uppercase">
                目前陣風
              </p>
              <p class="mt-1.5 text-sm font-black"><span data-current-gust></span> km/h</p>
            </div>
          </div>

          <div class="mt-5 flex items-center gap-2 text-xs font-bold text-white/55">
            <span class="size-1.5 rounded-full bg-emerald-300"></span>
            龍騰斷橋周邊・自動更新
          </div>
        </div>

        <div
          class="mt-7 hidden min-h-52 items-center justify-center rounded-2xl border border-white/10 bg-black/12 p-6"
          data-weather-error
          role="alert"
        >
          <div class="max-w-xs text-center">
            <span
              class="mx-auto flex size-11 items-center justify-center rounded-full bg-white/10"
            >
              <Icon name="mountain" size={21} />
            </span>
            <p class="mt-4 text-sm font-black">暫時無法載入天氣</p>
            <p class="mt-2 text-xs leading-6 text-white/58">
              山區天氣變化快，請稍後重試或直接查看中央氣象署。
            </p>
            <button
              type="button"
              class="mt-4 rounded-full border border-white/25 px-4 py-2 text-xs font-black transition hover:bg-white hover:text-forest-700"
              data-weather-retry
            >
              重新載入
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="p-6 sm:p-9">
      <div class="hidden" data-weather-details aria-live="polite">
        <div
          class="weather-advice rounded-2xl border p-5"
          data-weather-advice
          data-level="good"
        >
          <div class="flex items-start gap-3">
            <span
              class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-full bg-white/70"
            >
              <Icon name="sparkle" size={18} />
            </span>
            <div>
              <p class="text-sm font-black" data-advice-title></p>
              <p class="mt-2 text-sm leading-7 opacity-75" data-advice-text></p>
            </div>
          </div>
        </div>

        <div class="mt-7 flex items-center justify-between gap-4">
          <div>
            <p class="text-xs font-black tracking-[0.14em] text-stone uppercase">
              三日預報
            </p>
            <h3 class="editorial-title mt-2 text-2xl font-bold text-ink">斷橋周邊趨勢</h3>
          </div>
          <span
            class="rounded-full bg-forest-50 px-3 py-1.5 text-[0.68rem] font-black text-forest-600"
          >
            自動更新
          </span>
        </div>

        <div class="mt-5 grid gap-2 sm:grid-cols-3" data-forecast-list></div>
      </div>

      <div
        class="flex h-full min-h-96 items-center justify-center text-center"
        data-weather-details-placeholder
      >
        <div>
          <span
            class="mx-auto flex size-12 items-center justify-center rounded-full bg-forest-50 text-forest-600"
          >
            <Icon name="mountain" size={22} />
          </span>
          <p class="mt-4 text-sm font-black text-ink">正在整理三日預報</p>
          <p class="mt-2 text-xs text-stone">資料載入後會顯示行程提醒。</p>
        </div>
      </div>

      <div class="mt-7 border-t border-black/8 pt-5 text-xs leading-6 text-stone">
        <p>
          天氣預報僅供安排行程參考，不代表道路、景點周邊或鐵道自行車已確認開放。
        </p>
        <p class="mt-1.5">
          預報資料：
          <a
            href="https://open-meteo.com/"
            target="_blank"
            rel="noreferrer"
            class="font-black text-brick-700 underline decoration-brick-100 underline-offset-4"
          >
            Open-Meteo
          </a>
          <span aria-hidden="true">・</span>
          <a
            href="https://www.cwa.gov.tw/"
            target="_blank"
            rel="noreferrer"
            class="font-black text-brick-700 underline decoration-brick-100 underline-offset-4"
          >
            中央氣象署
          </a>
        </p>
      </div>

      <noscript>
        <p class="mt-5 rounded-xl bg-brick-50 p-4 text-sm leading-7 text-brick-700">
          請啟用 JavaScript 以查看天氣預報，或直接前往中央氣象署查詢苗栗縣三義鄉天氣。
        </p>
      </noscript>
    </div>
  </div>
</article>

<script>
  interface WeatherForecast {
    label: string;
    condition: string;
    icon: string;
    high: number | null;
    low: number | null;
    rainChance: number | null;
  }

  interface WeatherPayload {
    current: {
      temperature: number | null;
      apparentTemperature: number | null;
      condition: string;
      icon: string;
      windSpeed: number | null;
      windGust: number | null;
    };
    today: {
      high: number | null;
      low: number | null;
      rainChance: number | null;
    };
    forecast: WeatherForecast[];
    advice: {
      level: "good" | "watch" | "danger";
      title: string;
      text: string;
    };
  }

  const value = (input: number | null) => input ?? "—";

  function initializeWeatherCard(card: HTMLElement) {
    const loading = card.querySelector<HTMLElement>("[data-weather-loading]");
    const current = card.querySelector<HTMLElement>("[data-weather-current]");
    const error = card.querySelector<HTMLElement>("[data-weather-error]");
    const details = card.querySelector<HTMLElement>("[data-weather-details]");
    const placeholder = card.querySelector<HTMLElement>(
      "[data-weather-details-placeholder]",
    );
    const retry = card.querySelector<HTMLButtonElement>("[data-weather-retry]");

    const setText = (selector: string, content: string | number) => {
      const target = card.querySelector<HTMLElement>(selector);
      if (target) target.textContent = String(content);
    };

    const showLoading = () => {
      loading?.classList.remove("hidden");
      current?.classList.add("hidden");
      error?.classList.add("hidden");
      error?.classList.remove("flex");
      details?.classList.add("hidden");
      placeholder?.classList.remove("hidden");
    };

    const showError = () => {
      loading?.classList.add("hidden");
      current?.classList.add("hidden");
      error?.classList.remove("hidden");
      error?.classList.add("flex");
      details?.classList.add("hidden");
      placeholder?.classList.remove("hidden");
    };

    const render = (data: WeatherPayload) => {
      setText("[data-current-icon]", data.current.icon);
      setText("[data-current-condition]", data.current.condition);
      setText("[data-current-temperature]", value(data.current.temperature));
      setText("[data-current-apparent]", value(data.current.apparentTemperature));
      setText("[data-current-wind]", value(data.current.windSpeed));
      setText("[data-current-gust]", value(data.current.windGust));
      setText("[data-today-high]", value(data.today.high));
      setText("[data-today-low]", value(data.today.low));
      setText("[data-today-rain]", value(data.today.rainChance));
      setText("[data-advice-title]", data.advice.title);
      setText("[data-advice-text]", data.advice.text);

      const advice = card.querySelector<HTMLElement>("[data-weather-advice]");
      if (advice) advice.dataset.level = data.advice.level;

      const forecastList = card.querySelector<HTMLElement>("[data-forecast-list]");
      if (forecastList) {
        forecastList.replaceChildren(
          ...data.forecast.map((day) => {
            const item = document.createElement("div");
            item.className =
              "rounded-2xl border border-black/8 bg-cream/70 p-4 text-center";

            const label = document.createElement("p");
            label.className = "text-xs font-black text-stone";
            label.textContent = day.label;

            const icon = document.createElement("span");
            icon.className = "mt-3 block text-3xl";
            icon.setAttribute("aria-hidden", "true");
            icon.textContent = day.icon;

            const temperature = document.createElement("p");
            temperature.className = "mt-3 text-sm font-black text-ink";
            temperature.textContent = `${value(day.high)}° / ${value(day.low)}°`;

            const condition = document.createElement("p");
            condition.className = "mt-1 text-xs text-stone";
            condition.textContent = day.condition;

            const rain = document.createElement("p");
            rain.className = "mt-3 text-[0.68rem] font-black text-forest-600";
            rain.textContent = `降雨 ${value(day.rainChance)}%`;

            item.append(label, icon, temperature, condition, rain);
            return item;
          }),
        );
      }

      loading?.classList.add("hidden");
      error?.classList.add("hidden");
      error?.classList.remove("flex");
      current?.classList.remove("hidden");
      details?.classList.remove("hidden");
      placeholder?.classList.add("hidden");
    };

    const load = async () => {
      showLoading();

      try {
        const response = await fetch("/api/weather", {
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error("Weather request failed");
        render((await response.json()) as WeatherPayload);
      } catch {
        showError();
      }
    };

    retry?.addEventListener("click", load);
    void load();
  }

  document.querySelectorAll<HTMLElement>("[data-weather-card]").forEach((card) => {
    if (card.dataset.ready === "true") return;
    card.dataset.ready = "true";
    initializeWeatherCard(card);
  });
</script>

<style>
  .weather-loader {
    animation: weather-spin 0.8s linear infinite;
  }

  .weather-advice[data-level="good"] {
    border-color: #dce8df;
    background: #f3f7f4;
    color: #315847;
  }

  .weather-advice[data-level="watch"] {
    border-color: #ead1c7;
    background: #fbf5f1;
    color: #753126;
  }

  .weather-advice[data-level="danger"] {
    border-color: #efc3bc;
    background: #fff1ef;
    color: #842e25;
  }

  @keyframes weather-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .weather-loader {
      animation: none;
    }
  }
</style>
