---
import Icon from "./Icon.astro";
import { ATTRACTION, GOOGLE_REVIEW, ratingStars } from "../data/attraction";

interface Props {
  /** 讓外層可依版面決定是否顯示說明文字 */
  compact?: boolean;
}

const { compact = false } = Astro.props;
const stars = ratingStars(GOOGLE_REVIEW.rating);
const reviewCountDisplay = GOOGLE_REVIEW.reviewCount.toLocaleString("en-US");
---

<section
  class="overflow-hidden rounded-[1.75rem] border border-black/8 bg-white shadow-soft"
  aria-labelledby="google-review-heading"
>
  <div class="grid gap-0 sm:grid-cols-[auto_1fr]">
    <div
      class="flex flex-col items-center justify-center gap-1 bg-forest-700 px-8 py-7 text-center text-white sm:min-w-52"
    >
      <span class="text-5xl font-black leading-none tracking-[-0.05em]">
        {GOOGLE_REVIEW.rating.toFixed(1)}
      </span>
      <span class="mt-2 flex items-center gap-0.5" role="img" aria-label={`Google 使用者評分 ${GOOGLE_REVIEW.rating} 分，滿分 ${GOOGLE_REVIEW.max} 分`}>
        {
          stars.map(({ fill }) => (
            <span class="relative inline-block size-[1.05rem]">
              <svg viewBox="0 0 24 24" class="absolute inset-0 size-full text-white/28" fill="currentColor" aria-hidden="true">
                <path d="m12 2.6 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4 6.2 20.5l1.1-6.5L2.6 9.4l6.5-.9L12 2.6Z" />
              </svg>
              <span class="absolute inset-0 overflow-hidden" style={`width:${Math.round(fill * 100)}%`}>
                <svg viewBox="0 0 24 24" class="size-[1.05rem] text-[#f4b544]" fill="currentColor" aria-hidden="true">
                  <path d="m12 2.6 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4 6.2 20.5l1.1-6.5L2.6 9.4l6.5-.9L12 2.6Z" />
                </svg>
              </span>
            </span>
          ))
        }
      </span>
      <span class="mt-2 text-xs font-bold text-white/70">{reviewCountDisplay} 則評論</span>
    </div>

    <div class="p-6 sm:p-7">
      <p class="text-xs font-black tracking-[0.16em] text-brick-600 uppercase">
        Google 地圖評分
      </p>
      <h2
        id="google-review-heading"
        class="editorial-title mt-3 text-2xl font-bold text-ink sm:text-3xl"
      >
        {ATTRACTION.shortNameZh}旅客評價一覽
      </h2>

      {!compact && (
        <p class="mt-3 max-w-lg text-sm leading-7 text-stone">
          以下評分與評論數為 Google 地圖公開資料，由 Google
          地圖使用者累積產生。數字會隨時間變動，本站不將其視為自身評分，也不納入結構化資料。
        </p>
      )}

      <dl class="mt-5 grid gap-3 sm:grid-cols-3">
        <div class="rounded-xl border border-black/8 bg-cream/60 p-3.5">
          <dt class="text-[0.67rem] font-black tracking-[0.12em] text-stone uppercase">評分</dt>
          <dd class="mt-1 text-sm font-extrabold text-ink">{GOOGLE_REVIEW.rating} / {GOOGLE_REVIEW.max}</dd>
        </div>
        <div class="rounded-xl border border-black/8 bg-cream/60 p-3.5">
          <dt class="text-[0.67rem] font-black tracking-[0.12em] text-stone uppercase">評論數</dt>
          <dd class="mt-1 text-sm font-extrabold text-ink">{reviewCountDisplay} 則</dd>
        </div>
        <div class="rounded-xl border border-black/8 bg-cream/60 p-3.5">
          <dt class="text-[0.67rem] font-black tracking-[0.12em] text-stone uppercase">地點類別</dt>
          <dd class="mt-1 text-sm font-extrabold text-ink">{ATTRACTION.googleCategoryZh}</dd>
        </div>
      </dl>

      <div class="mt-5 flex flex-col gap-3 border-t border-black/8 pt-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-xs leading-6 text-stone">
          資料來源：
          <a
            href={GOOGLE_REVIEW.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="font-black text-brick-700 underline decoration-brick-100 underline-offset-4"
          >
            {GOOGLE_REVIEW.sourceName}
          </a>
          <span aria-hidden="true">・</span>
          最後核對：{GOOGLE_REVIEW.checkedAtDisplay}
        </p>
        <a
          href={GOOGLE_REVIEW.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-forest-700 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-forest-600"
        >
          <Icon name="map" size={17} />
          查看 Google 評論
        </a>
      </div>
    </div>
  </div>
</section>
