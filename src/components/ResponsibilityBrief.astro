---
import Icon from "./Icon.astro";

const sciencePoints = [
  {
    icon: "mountain",
    title: "為什麼橋會斷在這裡",
    text: "1935 年的關刀山大地震在短短數十秒內改變了地表的受力，磚造拱橋對水平錯動極為敏感，這正是魚藤坪橋斷成數截的原因。",
  },
  {
    icon: "book",
    title: "紅磚拱的力學邏輯",
    text: "拱圈靠「互相推擠」把重量傳到兩端橋墩，磚塊本身耐壓卻怕拉力；一旦橋墩位移，拱圈就會從最脆弱的接縫處裂開。",
  },
  {
    icon: "leaf",
    title: "斷橋如何變成棲地",
    text: "百年來紅磚與混凝土縫隙長出蕨類與苔蘚，成為昆蟲、蜥蜴與鳥類的微棲地，遺構同時是文化資產也是生態空間。",
  },
] as const;

const duties = [
  {
    title: "不攀爬、不觸摸",
    text: "磚面與砂漿正在風化，手上的油脂與重量都會加速損壞。這裡是法定文化資產，違規攀爬可依相關法規處理。",
  },
  {
    title: "垃圾自己帶下山",
    text: "山區垃圾桶極少甚至沒有。果皮、菸蒂與衛生紙都不會自然分解，請全部帶回市區丟棄。",
  },
  {
    title: "不打擾野生動物",
    text: "不餵食獼猴與鳥類、不捕捉昆蟲、賞螢不使用閃光燈。餵食會改變動物行為，並提高人獸衝突風險。",
  },
  {
    title: "遵守水域與空拍規範",
    text: "魚藤坪溪屬水庫上游集水區，禁止戲水與洗滌；空拍與商業攝影須依相關規定申請，切勿違規飛行。",
  },
] as const;
---

<section class="section-shell pt-20 sm:pt-28" aria-labelledby="responsibility-heading">
  <div class="grid gap-4 lg:grid-cols-[1.05fr_0.95fr]">
    <div class="rounded-[2rem] border border-black/8 bg-white p-6 shadow-soft sm:p-9">
      <p class="text-xs font-black tracking-[0.2em] text-brick-700 uppercase">
        科普
      </p>
      <h2
        id="responsibility-heading"
        class="editorial-title mt-4 text-3xl font-bold leading-tight text-ink sm:text-4xl"
      >
        看懂它為什麼斷，<br />才會知道它為什麼珍貴
      </h2>
      <p class="mt-5 text-sm leading-7 text-stone sm:text-base">
        龍騰斷橋不只是拍照景點，它是一堂露天的地震工程與文化資產課。
        理解背後的原理，你會發現現場值得停留的時間比想像中長。
      </p>

      <ul class="mt-7 space-y-4">
        {
          sciencePoints.map((point) => (
            <li class="flex gap-4 rounded-2xl bg-cream/70 p-5">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-white text-forest-700 shadow-sm">
                <Icon name={point.icon} size={19} />
              </span>
              <div>
                <p class="text-sm font-black text-ink">{point.title}</p>
                <p class="mt-2 text-xs leading-6 text-stone">{point.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <a
        href="/science-and-responsibility/"
        class="mt-7 inline-flex items-center gap-2 rounded-full bg-forest-700 px-5 py-3 text-sm font-black text-white transition hover:bg-forest-800"
      >
        <Icon name="book" size={17} />
        科普與訪客責任完整版
      </a>
    </div>

    <div class="rounded-[2rem] border border-brick-100 bg-brick-50 p-6 sm:p-9">
      <p class="flex items-center gap-2 text-xs font-black tracking-[0.2em] text-brick-700 uppercase">
        <Icon name="shield" size={15} />
        訪客責任
      </p>
      <h2 class="editorial-title mt-4 text-2xl font-bold leading-tight text-ink sm:text-3xl">
        讓下一個人也能看到同樣的斷橋
      </h2>
      <p class="mt-4 text-sm leading-7 text-brick-700/85">
        這裡沒有圍牆也沒有售票口，遺構的保存全靠每一位訪客的自制。
      </p>

      <ul class="mt-7 space-y-3">
        {
          duties.map((duty, index) => (
            <li class="rounded-2xl border border-brick-100 bg-white/80 p-5">
              <p class="flex items-center gap-2 text-sm font-black text-ink">
                <span class="flex size-6 items-center justify-center rounded-full bg-brick-50 text-[0.65rem] font-black text-brick-700">
                  {index + 1}
                </span>
                {duty.title}
              </p>
              <p class="mt-2 text-xs leading-6 text-stone">{duty.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-6 rounded-2xl bg-white/80 p-5">
        <p class="flex items-center gap-2 text-[0.68rem] font-black tracking-[0.12em] text-brick-700 uppercase">
          <Icon name="health" size={14} />
          緊急狀況
        </p>
        <p class="mt-2 text-xs leading-6 text-stone">
          119（消防與救護）、110（警察）；山區無訊號時可試 112。
          蜂螫與蛇咬請保持鎮定、減少活動並儘速就醫。
        </p>
      </div>
    </div>
  </div>
</section>
